.page-shell {
  --bg: #dcebf2; --bg-deep: #cbdfe8; --ink: #43586d; --ink-soft: rgba(67,88,109,.64); --camera-action:#7299b5;
  position: relative; min-height: 100vh; padding: 0 52rpx calc(52rpx + env(safe-area-inset-bottom));
  overflow: hidden; background: var(--bg); color: var(--ink);
}
.tone-sage { --bg:#e7f8ea; --bg-deep:#d8efdd; --ink:#40594d; --ink-soft:rgba(64,89,77,.62); --camera-action:#7d987f; }
.tone-rose { --bg:#eee1df; --bg-deep:#dec9c6; --ink:#6b4d4a; --ink-soft:rgba(107,77,74,.62); --camera-action:#b47f7e; }
.tone-sand { --bg:#eadfce; --bg-deep:#dac8ad; --ink:#695846; --ink-soft:rgba(105,88,70,.62); --camera-action:#876b57; }
.spray-layer { position:absolute; inset:0; background:radial-gradient(ellipse at 22% 18%,rgba(255,255,255,.28),transparent 44%),radial-gradient(ellipse at 76% 72%,rgba(91,113,124,.08),transparent 52%),repeating-linear-gradient(9deg,rgba(255,255,255,.025) 0 1rpx,transparent 1rpx 9rpx),linear-gradient(145deg,rgba(255,255,255,.12),transparent 48%,rgba(90,110,120,.04)); opacity:.66; pointer-events:none; }
.safe-top { height:calc(env(safe-area-inset-top) + 100rpx); min-height:136rpx; }
.page-brand { position:relative; z-index:1; margin:14rpx 0 28rpx; font-family:"STKaiti","KaiTi",serif; font-size:40rpx; letter-spacing:14rpx; text-align:center; opacity:.72; }
.paper-card { position:relative; z-index:1; width:100%; padding:54rpx 48rpx 66rpx; border-radius:8rpx 9rpx 12rpx 8rpx; background:radial-gradient(ellipse at 18% 12%,rgba(255,255,255,.34),transparent 48%),repeating-linear-gradient(7deg,rgba(126,103,72,.014) 0 1rpx,transparent 1rpx 13rpx),repeating-linear-gradient(96deg,rgba(255,255,255,.08) 0 1rpx,transparent 1rpx 17rpx),#f4eee2; box-shadow:0 3rpx 0 #d6ccbb,0 7rpx 0 rgba(180,166,144,.56),0 26rpx 48rpx rgba(70,77,74,.19),inset 0 0 44rpx rgba(255,255,255,.22); box-sizing:border-box; }
.paper-card::before { content:""; position:absolute; inset:0; border-radius:inherit; box-shadow:inset 2rpx 2rpx 0 rgba(255,255,255,.52),inset -2rpx -2rpx 0 rgba(125,104,74,.12); pointer-events:none; }
.paper-depth { position:absolute; left:10rpx; right:10rpx; bottom:-8rpx; height:16rpx; border-radius:0 0 10rpx 10rpx; background:rgba(173,155,128,.38); filter:blur(2rpx); }
.record-row { position:relative; z-index:2; display:flex; justify-content:space-between; align-items:center; margin-bottom:28rpx; font-family:"Courier New",monospace; font-size:22rpx; letter-spacing:4rpx; }
.record-row text:last-child { color:var(--ink-soft); letter-spacing:3rpx; }
.view-window { position:relative; z-index:2; width:100%; height:438rpx; padding:0; overflow:hidden; border:0; border-radius:28rpx; background:rgba(225,232,228,.34); color:var(--ink); box-shadow:0 0 0 3rpx rgba(173,139,87,.22),0 0 18rpx 5rpx rgba(230,196,133,.38),inset 0 0 0 3rpx rgba(255,255,255,.62),inset 0 0 28rpx rgba(255,251,232,.42),0 8rpx 16rpx rgba(93,78,60,.18); transition:height 260ms ease,opacity 180ms ease,transform 180ms ease; }
.view-window--portrait { height:600rpx; width:72%; margin:0 auto; }
.view-window.view-window--upload { width:100% !important; height:438rpx !important; margin:0 !important; }
.view-window--pressed { opacity:.86; transform:scale(.994); }
.view-photo { position:absolute; inset:0; width:100%; height:100%; filter:saturate(.86) contrast(.94); }
.empty-glow { position:absolute; inset:0; overflow:hidden; background:linear-gradient(145deg,var(--bg),var(--bg-deep)); }
.glow-orb { position:absolute; border-radius:50%; filter:blur(42rpx); }
.glow-orb--one { width:330rpx; height:230rpx; left:-40rpx; top:-20rpx; background:rgba(255,255,242,.56); }
.glow-orb--two { width:300rpx; height:260rpx; right:-20rpx; bottom:-40rpx; background:rgba(255,224,174,.28); }
.glass-reflection { position:absolute; inset:0; background:linear-gradient(118deg,rgba(255,255,255,.34),transparent 25%,transparent 68%,rgba(255,248,221,.16)); pointer-events:none; }
.glass-edge { position:absolute; inset:8rpx; border-radius:22rpx; box-shadow:inset 8rpx 8rpx 18rpx rgba(255,255,255,.22),inset -7rpx -7rpx 15rpx rgba(109,89,62,.11); pointer-events:none; }
.finder-corner { position:absolute; width:36rpx; height:36rpx; border-color:rgba(255,255,255,.88); border-style:solid; z-index:3; }
.finder-corner--tl { left:24rpx; top:24rpx; border-width:3rpx 0 0 3rpx; }.finder-corner--tr { right:24rpx; top:24rpx; border-width:3rpx 3rpx 0 0; }.finder-corner--bl { left:24rpx; bottom:24rpx; border-width:0 0 3rpx 3rpx; }.finder-corner--br { right:24rpx; bottom:24rpx; border-width:0 3rpx 3rpx 0; }
.window-prompt { position:absolute; z-index:4; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
.prompt-plus { position:relative; width:70rpx; height:70rpx; margin-bottom:22rpx; border:2rpx solid currentColor; border-radius:50%; }.prompt-plus view { position:absolute; left:50%; top:50%; background:currentColor; transform:translate(-50%,-50%); }.prompt-plus view:first-child { width:24rpx; height:2rpx; }.prompt-plus view:last-child { width:2rpx; height:24rpx; }
.prompt-main { font-family:"STKaiti","KaiTi",serif; font-size:30rpx; letter-spacing:3rpx; }.prompt-sub { margin-top:10rpx; font-size:20rpx; letter-spacing:3rpx; opacity:.68; }
.window-prompt--light { color:#fff; text-shadow:0 2rpx 8rpx rgba(0,0,0,.18); }.analysis-label { font-family:"STKaiti","KaiTi",serif; font-size:31rpx; letter-spacing:4rpx; }
.progress-track { width:48%; height:2rpx; margin-top:24rpx; background:rgba(255,255,255,.34); }.progress-fill { height:100%; background:#fff; transition:width 260ms ease; }
.flavor-heading { position:relative; z-index:2; width:100%; margin:32rpx 0 24rpx; display:flex; align-items:center; gap:32rpx; }.flavor-heading text { flex:none; font-family:"Courier New",monospace; font-size:18rpx; letter-spacing:2rpx; white-space:nowrap; }.heading-rule { flex:1; height:1rpx; background:var(--ink-soft); }
.empty-record { position:relative; z-index:2; min-height:340rpx; display:flex; align-items:center; justify-content:center; }.empty-tear { width:76%; padding:14rpx; background:rgba(211,199,181,.42); clip-path:polygon(2% 13%,8% 6%,17% 10%,25% 4%,35% 9%,45% 3%,57% 8%,68% 4%,79% 10%,90% 5%,98% 14%,96% 86%,88% 94%,77% 90%,67% 97%,54% 91%,43% 96%,31% 90%,18% 96%,7% 89%,1% 78%); }.empty-tear-inner { min-height:240rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; background:rgba(231,224,211,.56); clip-path:inherit; }.empty-main { font-family:"STKaiti","KaiTi",serif; font-size:31rpx; letter-spacing:4rpx; }.empty-sub { margin-top:14rpx; font-size:21rpx; letter-spacing:3rpx; color:var(--ink-soft); }
.result-record { position:relative; z-index:2; display:flex; flex-direction:column; align-items:center; }.food-opening { position:relative; width:78%; height:330rpx; overflow:hidden; background:#d8cdbb; clip-path:polygon(2% 11%,8% 4%,17% 8%,27% 2%,37% 7%,47% 1%,58% 6%,68% 2%,79% 9%,90% 4%,98% 12%,96% 87%,88% 95%,78% 91%,67% 98%,55% 92%,43% 97%,31% 91%,18% 96%,7% 89%,1% 77%); filter:drop-shadow(0 7rpx 7rpx rgba(78,61,41,.22)); }.food-image { width:100%; height:100%; transform:scale(1.05); }.torn-light { position:absolute; inset:6rpx; clip-path:inherit; box-shadow:inset 0 0 22rpx rgba(255,249,234,.72); }
.food-name { margin-top:28rpx; max-width:88%; font-family:"STKaiti","KaiTi",serif; font-size:36rpx; letter-spacing:5rpx; line-height:1.4; text-align:center; }.food-notes { margin-top:13rpx; font-family:"STKaiti","KaiTi",serif; font-size:23rpx; letter-spacing:5rpx; text-align:center; }.temp-note { margin-top:16rpx; font-family:"Courier New",monospace; font-size:15rpx; letter-spacing:2rpx; opacity:.46; }
.tone-panel { position:relative; z-index:2; margin:32rpx auto 0; display:flex; align-items:center; justify-content:center; gap:24rpx; }.tone-title { font-family:"STKaiti","KaiTi",serif; font-size:24rpx; letter-spacing:3rpx; }.tone-options { display:flex; gap:18rpx; }.tone-dot { display:block; flex:0 0 52rpx; width:52rpx; height:52rpx; min-width:52rpx; min-height:52rpx; margin:0; padding:0; border:5rpx solid rgba(255,255,255,.48); border-radius:50%; line-height:52rpx; box-shadow:0 0 0 1rpx rgba(40,48,48,.15); }.tone-dot--blue { background:#dcebf2; }.tone-dot--sage { background:#e7f8ea; }.tone-dot--rose { background:#eee1df; }.tone-dot--sand { background:#eadfce; }.tone-dot.is-selected { box-shadow:0 0 0 2rpx var(--ink),0 0 0 6rpx rgba(255,255,255,.45); }
.result-actions { position:relative; z-index:2; margin-top:28rpx; display:flex; justify-content:center; gap:18rpx; }.primary-action,.quiet-action { min-height:88rpx; margin:0; padding:0 38rpx; border-radius:999rpx; font-size:25rpx; }.primary-action { background:var(--ink); color:#fff; }.quiet-action { border:1rpx solid var(--ink-soft); background:rgba(255,255,255,.2); color:var(--ink); }.privacy { position:relative; z-index:2; display:block; margin-top:24rpx; color:var(--ink-soft); font-size:18rpx; letter-spacing:2rpx; text-align:center; }.analysis-canvas { position:fixed; left:-200rpx; top:-200rpx; opacity:0; pointer-events:none; }

/* Reference-proportion pass */
.page-brand { margin-bottom:20rpx; }
.tone-panel { margin:0 auto 30rpx; }
.paper-card { min-height:1160rpx; padding-bottom:38rpx; display:flex; flex-direction:column; }
.view-window { height:310rpx; }
.view-window--portrait { width:100%; height:650rpx; margin:0; }
.view-window.view-window--upload { width:100% !important; height:310rpx !important; margin:0 !important; }
.empty-record { min-height:420rpx; flex-direction:column; }
.food-opening { width:100%; height:300rpx; }
.food-opening--portrait { width:84%; height:430rpx; }
.food-opening--smooth { clip-path:ellipse(43.2% 40.8% at 50% 50%); }
.food-opening--portrait.food-opening--smooth { clip-path:ellipse(44.6% 43.8% at 50% 50%); }
.tone-add { position:relative; background:rgba(255,255,255,.16); border:2rpx solid rgba(126,96,60,.55); }
.tone-add view { position:absolute; left:50%; top:50%; background:var(--ink); transform:translate(-50%,-50%); }
.tone-add view:first-child { width:22rpx; height:2rpx; }
.tone-add view:last-child { width:2rpx; height:22rpx; }
.tear-selector { width:100%; margin-top:24rpx; display:flex; align-items:center; font-family:"STKaiti","KaiTi",serif; font-size:22rpx; letter-spacing:2rpx; }
.tear-title { flex:0 0 136rpx; white-space:nowrap; line-height:1; text-align:left; }
.tear-choice { flex:1 1 0; width:auto; height:72rpx; min-width:0; min-height:72rpx; margin:0; padding:0 8rpx; display:flex; align-items:center; justify-content:center; gap:10rpx; border:0; background:transparent; color:var(--ink); font-size:22rpx; line-height:1; box-sizing:border-box; }
.tear-choice-label { white-space:nowrap; line-height:1; text-align:center; }
.choice-dot { width:30rpx; height:30rpx; border:2rpx solid rgba(126,96,60,.55); border-radius:50%; box-sizing:border-box; }
.tear-choice.is-selected .choice-dot { border:6rpx solid #f7f0e4; background:#6f99b8; box-shadow:0 0 0 2rpx rgba(126,96,60,.55); }
.card-actions { position:relative; z-index:2; width:100%; margin-top:auto; padding-top:32rpx; display:flex; align-items:center; gap:22rpx; }
.card-action { flex:1 1 0; height:88rpx; min-width:0; min-height:88rpx; margin:0; padding:0 18rpx; display:flex; align-items:center; justify-content:center; border-radius:999rpx; font-family:"STKaiti","KaiTi",serif; font-size:24rpx; line-height:1; letter-spacing:2rpx; white-space:nowrap; box-sizing:border-box; }
.card-action--quiet { border:1rpx solid rgba(105,83,55,.55); background:transparent; color:var(--ink); }
.card-action--primary { background:#78a1c0; color:#fff; }
.card-action--camera { background:var(--camera-action); transition:background-color 180ms ease; }

/* Keep native button sizing consistent between DevTools and real devices. */
.tone-panel { width:100%; box-sizing:border-box; }
.tone-title { flex:0 0 auto; }
.tone-options { flex:0 0 332rpx; width:332rpx; min-width:332rpx; display:flex; align-items:center; justify-content:space-between; gap:0; }
.tone-slot { flex:0 0 52rpx; width:52rpx; height:52rpx; }
.tone-slot .tone-dot { width:52rpx; height:52rpx; min-width:52rpx; min-height:52rpx; margin:0 !important; padding:0 !important; box-sizing:border-box; }
.tone-slot .tone-dot::after { border:0; }

.food-opening--smooth { overflow:hidden; background:transparent; }
.food-opening--smooth .food-image { width:100%; height:100%; transform:none; clip-path:ellipse(43.2% 40.8% at 50% 50%); }
.food-opening--portrait.food-opening--smooth .food-image { clip-path:ellipse(44.6% 43.8% at 50% 50%); }
.food-image-fallback { width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:var(--ink-soft); font-family:"STKaiti","KaiTi",serif; font-size:22rpx; letter-spacing:3rpx; }

/* Two-layer reveal: masked photo below, matching paper-fiber edge above. */
.food-opening--natural {
  overflow:visible;
  background:transparent;
  clip-path:none;
  filter:none;
}
.food-opening--natural .food-image {
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  transform:none;
  clip-path:none;
}
.food-opening--natural .torn-light {
  display:block;
  position:absolute;
  z-index:2;
  inset:0;
  width:100%;
  height:100%;
  pointer-events:none;
  filter:none;
}
.food-opening--natural .food-image {
  object-fit:contain;
}
.mask-canvas { position:fixed; left:-1200px; top:-1200px; opacity:0; pointer-events:none; }
